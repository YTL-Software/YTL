{
  "name": "ytl",
  "displayName": "YTL",
  "description": "YTL (Yggdrasil Template Language) is a new minimalist text format designed for configurations, logs, and declarative data structures. Its defining feature is a tree-like architecture and unique inverted inheritance that completely eliminates code duplication and visual clutter.",
  "version": "1.4.0",
  "icon": "icon.jpg",
  "publisher": "Regent",
  "repository": {
    "type": "git",
    "url": "https://github.com/Regentq/YTL"
  },
  "main": "./extension.js",
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ytl",
        "aliases": [
          "YTL",
          "ytl"
        ],
        "extensions": [
          ".ytl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ytl",
        "scopeName": "source.ytl",
        "path": "./syntaxes/ytl.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[ytl]": {
        "editor.formatOnType": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4
      }
    }
  }
}