# English localization for YTL LSP
ErrorMessages:
    # IPv4
    ipv4_octet_name "Octet"
    ipv4_invalid_format "IPv4: invalid format"
    ipv4_expected_octets "Expected 4 octets, found {}."
    ipv4_empty_octet "IPv4: empty octet"
    ipv4_empty_octet_msg "Octet {} is empty. Check for double dots (..)."
    ipv4_octet_too_long "IPv4: octet too long"
    ipv4_octet_too_long_msg "Octet {} has {} characters, but max is 3."
    ipv4_leading_zero "IPv4: leading zero"
    ipv4_leading_zero_msg "Octet {} has a leading zero ('{}'). Use '{}'."
    ipv4_out_of_range "IPv4: octet out of range"
    ipv4_out_of_range_msg "Octet {} = {} (maximum is 255)"
    ipv4_all_out_of_range "IPv4: all octets out of range"
    ipv4_all_out_of_range_msg "All 4 octets exceed the maximum value of 255."
    ipv4_multiple_out_of_range "IPv4: multiple octets out of range"
    ipv4_multiple_out_of_range_msg "Octets {} exceed the maximum value of 255."
    ipv4_invalid_chars "IPv4: invalid character"
    ipv4_invalid_chars_msg "Octets {} contain non-digit characters."
    ipv4_quotes_forbidden "IPv4: quotes forbidden"
    ipv4_quotes_forbidden_msg "Remove the quotation marks. Example: 192.168.0.1"
    ipv4_spaces_forbidden "IPv4: spaces forbidden"
    ipv4_spaces_forbidden_msg "Remove spaces and special characters (\t, \n) inside the value."
    ipv4_port_forbidden "IPv4: colon forbidden"
    ipv4_port_forbidden_msg "Colons are forbidden in IPv4. Remove the port or IPv6 prefix."
    ipv4_cidr_forbidden "IPv4: CIDR forbidden"
    ipv4_cidr_forbidden_msg "Remove the subnet mask (e.g., '/24'). Use type '> cidr' for masks."
    ipv4_number_instead "IPv4: invalid format"
    ipv4_number_instead_msg "You entered a number or HEX. Use the format '192.168.0.1' (4 octets separated by dots)."
    ipv4_start_end_dot "IPv4: empty octet"
    ipv4_start_end_dot_msg "String cannot start or end with a dot. Check the format."
    ipv4_bad_char "IPv4: invalid character"
    ipv4_bad_char_msg "Octet {} contains invalid character {}. Only digits 0-9 are allowed."
    ipv4_octet_too_long_new "IPv4: octet too long"
    ipv4_octet_too_long_new_msg "Octet {} has {} characters, but max is 3. Value '{}' is too long."
    ipv4_multiple_bad_chars "IPv4: invalid characters found"
    ipv4_multiple_bad_chars_msg "Invalid characters found in the IP address: {}"
    ipv4_bad_dot "IPv4: invalid separator"
    ipv4_bad_dot_msg "You used the character {} instead of a regular dot '.' (U+002E)."

    # IPv6
    ipv6_group_name "Group"
    ipv6_whitespace "IPv6: whitespace not allowed"
    ipv6_whitespace_msg "Remove spaces inside the value."
    ipv6_brackets "IPv6: brackets not allowed"
    ipv6_brackets_msg "Use '::1' instead of '[::1]' in configs."
    ipv6_multiple_colons "IPv6: multiple '::'"
    ipv6_multiple_colons_msg "Found {} occurrences of '::', but only 1 is allowed."
    ipv6_triple_colons "IPv6: invalid format (:::)"
    ipv6_triple_colons_msg "Too many consecutive colons (:::) are not allowed."
