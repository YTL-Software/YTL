    ipv6_missing_group_msg "Expected {} groups, found {}."
    ipv6_too_many_groups "IPv6: too many groups"
    ipv6_too_many_groups_msg "Found {} groups, but with '::' there must be less than 8 (since '::' replaces zeros). Remove extra groups or remove '::'."
    ipv6_empty_first_group "IPv6: empty first group"
    ipv6_empty_first_group_msg "Address cannot start with a single ':' (use '::' to compress)."
    ipv6_empty_last_group "IPv6: empty last group"
    ipv6_empty_last_group_msg "Address cannot end with a single ':' (use '::' to compress)."
    ipv6_invalid_embedded_ipv4 "IPv6: invalid embedded IPv4"
    ipv6_group_too_long "IPv6: group too long"
    ipv6_group_too_long_msg "Group {} has {} hex digits, but maximum is 4."
    ipv6_invalid_char "IPv6: invalid character"
    ipv6_invalid_char_msg "Group {} contains '{}', but only hex digits are allowed."
    ipv6_invalid_format "IPv6: invalid format"
    ipv6_invalid_format_msg "Check the address structure."
    ipv6_quotes_forbidden "IPv6: quotes forbidden"
    ipv6_quotes_forbidden_msg "Remove quotes, example: ::1"
    ipv6_bad_char "IPv6: invalid character"
    ipv6_bad_char_msg "Group '{}' contains invalid character {}. Only hex digits (0-9, a-f) are allowed."
    ipv6_cidr_forbidden "IPv6: CIDR forbidden"
    ipv6_cidr_forbidden_msg "Remove the subnet mask (e.g., '/64'). Use type '> cidr'."
    ipv6_bad_dot "IPv6: invalid separator"
    ipv6_bad_dot_msg "Fake colons found: {} Use a regular ':' (U+003A)."
    ipv6_multiple_bad_chars "IPv6: invalid characters found"
    ipv6_multiple_bad_chars_msg "Invalid characters found in IPv6: {}"
    # CIDR
    cidr_missing_prefix "CIDR: missing prefix"
