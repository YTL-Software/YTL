    cidr_subnet_mask "CIDR: subnet mask forbidden"
    cidr_subnet_mask_msg "Use prefix length (e.g., /24), not a subnet mask (255.255.255.0)."
    cidr_prefix_too_large_ipv4 "CIDR: prefix too large"
    cidr_prefix_too_large_ipv4_msg "IPv4 prefix cannot be greater than 32."
    cidr_prefix_too_large_ipv6 "CIDR: prefix too large"
    cidr_prefix_too_large_ipv6_msg "IPv6 prefix cannot be greater than 128."
    cidr_multiple_bad_chars "CIDR: invalid characters in prefix"
    cidr_multiple_bad_chars_msg "Prefix contains invalid characters: {}"
    
