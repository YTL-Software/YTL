# Russian localization for YTL LSP
ErrorMessages:
    # IPv4
    ipv4_octet_name "Октет"
    ipv4_invalid_format "IPv4: неверный формат"
    ipv4_expected_octets "Ожидалось 4 октета, найдено {}."
    ipv4_empty_octet "IPv4: пустой октет"
    ipv4_empty_octet_msg "Октет {} пуст. Проверьте на двойные точки (..)."
    ipv4_octet_too_long "IPv4: октет слишком длинный"
    ipv4_octet_too_long_msg "Октет {} содержит {} символов, но максимум 3."
    ipv4_leading_zero "IPv4: ведущий ноль"
    ipv4_leading_zero_msg "Октет {} имеет ведущий ноль ('{}'). Используйте '{}'."
    ipv4_out_of_range "IPv4: октет вне диапазона"
    ipv4_out_of_range_msg "Октет {} = {} (максимум 255)"
    ipv4_all_out_of_range "IPv4: все октеты вне диапазона"
    ipv4_all_out_of_range_msg "Все 4 октета превышают максимальное значение 255."
    ipv4_multiple_out_of_range "IPv4: несколько октетов вне диапазона"
    ipv4_multiple_out_of_range_msg "Октеты {} превышают максимальное значение 255."
    ipv4_invalid_chars "IPv4: недопустимый символ"
    ipv4_invalid_chars_msg "Октеты {} содержат нецифровые символы."
    ipv4_quotes_forbidden "IPv4: кавычки запрещены"
    ipv4_quotes_forbidden_msg "Уберите кавычки, пример: 1.1.1.1"
    ipv4_spaces_forbidden "IPv4: пробелы запрещены"
    ipv4_spaces_forbidden_msg "Удалите пробелы и спецсимволы (\t, \n) внутри значения."
    ipv4_port_forbidden "IPv4: двоеточие запрещено"
    ipv4_port_forbidden_msg "Двоеточия запрещены в IPv4. Уберите порт или IPv6-префикс."
    ipv4_cidr_forbidden "IPv4: CIDR запрещен"
    ipv4_cidr_forbidden_msg "Уберите маску подсети (например, '/24'). Для масок используйте тип '> cidr'."
    ipv4_number_instead "IPv4: неверный формат"
    ipv4_number_instead_msg "Вы ввели число или HEX. Используйте формат '192.168.0.1' (4 октета через точку)."
    ipv4_start_end_dot "IPv4: пустой октет"
    ipv4_start_end_dot_msg "Строка не может начинаться или заканчиваться точкой. Проверьте формат."
    ipv4_bad_char "IPv4: недопустимый символ"
    ipv4_bad_char_msg "Октет {} содержит недопустимый символ {}. Разрешены только цифры 0-9."
    ipv4_octet_too_long_new "IPv4: октет слишком длинный"
    ipv4_octet_too_long_new_msg "Октет {} содержит {} символов, но максимум 3. Значение '{}' слишком длинное."
    ipv4_multiple_bad_chars "IPv4: найдены недопустимые символы"
    ipv4_multiple_bad_chars_msg "В IP-адресе обнаружены недопустимые символы: {}"
    ipv4_bad_dot "IPv4: неверный разделитель"
    ipv4_bad_dot_msg "Вы использовали символ {} вместо обычной точки '.' (U+002E)."
    
    # IPv6
    ipv6_group_name "Группа"
    ipv6_whitespace "IPv6: пробелы запрещены"
    ipv6_whitespace_msg "Удалите пробелы внутри значения."
    ipv6_brackets "IPv6: скобки запрещены"
    ipv6_brackets_msg "Используйте '::1' вместо '[::1]' в конфигах."
    ipv6_multiple_colons "IPv6: несколько '::'"
    ipv6_multiple_colons_msg "Найдено {} вхождений '::', но разрешено только 1."
    ipv6_triple_colons "IPv6: неверный формат (:::)"
    ipv6_triple_colons_msg "Слишком много идущих подряд двоеточий (:::)."
    ipv6_missing_group "IPv6: не хватает группы"
    ipv6_missing_group_msg "Ожидалось {} групп, найдено {}."
    ipv6_too_many_groups "IPv6: слишком много групп"
    ipv6_too_many_groups_msg "Найдено {} групп, но при использовании '::' их должно быть меньше 8 (так как '::' заменяет нули). Уберите лишние группы или удалите '::'."
    ipv6_empty_first_group "IPv6: пустая первая группа"
    ipv6_empty_first_group_msg "Адрес не может начинаться с одного ':' (используйте '::' для сжатия)."
    ipv6_empty_last_group "IPv6: пустая последняя группа"
    ipv6_empty_last_group_msg "Адрес не может заканчиваться на один ':' (используйте '::' для сжатия)."
    ipv6_invalid_embedded_ipv4 "IPv6: неверный вложенный IPv4"
    ipv6_group_too_long "IPv6: группа слишком длинная"
    ipv6_group_too_long_msg "Группа {} содержит {} hex-цифр, но максимум 4."
    ipv6_invalid_char "IPv6: недопустимый символ"
    ipv6_invalid_char_msg "Группа {} содержит '{}', но разрешены только hex-цифры."
    ipv6_invalid_format "IPv6: неверный формат"
    ipv6_invalid_format_msg "Проверьте структуру адреса."
    ipv6_quotes_forbidden "IPv6: кавычки запрещены"
    ipv6_quotes_forbidden_msg "Уберите кавычки, пример: ::1"
    ipv6_bad_char "IPv6: недопустимый символ"
    ipv6_bad_char_msg "Группа '{}' содержит недопустимый символ {}. Разрешены только hex-цифры (0-9, a-f)."
    ipv6_cidr_forbidden "IPv6: CIDR запрещен"
    ipv6_cidr_forbidden_msg "Уберите маску подсети (например, '/64'). Используйте тип '> cidr'."
    ipv6_bad_dot "IPv6: неверный разделитель"
    ipv6_bad_dot_msg "Найдены поддельные двоеточия: {} Используйте обычное ':' (U+003A)."
    ipv6_multiple_bad_chars "IPv6: найдены недопустимые символы"
    ipv6_multiple_bad_chars_msg "В IPv6 обнаружены недопустимые символы: {}"
    # CiDR
    cidr_missing_prefix "CIDR: отсутствует префикс"
    cidr_missing_prefix_msg "CIDR должен содержать префикс (например, 192.168.1.0/24)."
    cidr_too_many_slashes "CIDR: слишком много слэшей"
    cidr_too_many_slashes_msg "Используйте только один '/' (например, 192.168.1.0/24)."
    cidr_prefix_out_of_range_ipv4 "CIDR: префикс IPv4 вне диапазона"
    cidr_prefix_out_of_range_ipv4_msg "Префикс IPv4 должен быть от 0 до 32, получено {}."
    cidr_prefix_out_of_range_ipv6 "CIDR: префикс IPv6 вне диапазона"
    cidr_prefix_out_of_range_ipv6_msg "Префикс IPv6 должен быть от 0 до 128, получено {}."
    cidr_invalid_prefix "CIDR: неверный префикс"
    cidr_invalid_prefix_msg "Значение '{}' не является числом. Префикс должен быть положительным целым числом."
    cidr_leading_zero "CIDR: ведущий ноль в префиксе"
    cidr_leading_zero_msg "Префикс '{}' содержит ведущий ноль. Используйте '{}'."
    cidr_bad_char "CIDR: недопустимый символ в префиксе"
    cidr_bad_char_msg "Префикс содержит недопустимый символ: {}"
    cidr_backslash "CIDR: неверный слэш"
    cidr_backslash_msg "Используйте прямой слэш '/', а не обратный '\'."
    cidr_missing_prefix_ipv6 "CIDR: отсутствует префикс"
    cidr_missing_prefix_ipv6_msg "Похоже, вы ввели IPv6-адрес. Для CIDR добавьте маску (например, /64)."
    cidr_empty_ip "CIDR: отсутствует IP-адрес"
    cidr_empty_ip_msg "Перед маской должен быть IP-адрес (например, 192.168.1.0/24)."
    cidr_double_dot "CIDR: двойная точка"
    cidr_double_dot_msg "Двойная точка ('..') не допускается."
    cidr_empty_prefix "CIDR: пустой префикс"
    cidr_empty_prefix_msg "После '/' должен быть указан префикс (например, 24)."
    cidr_subnet_mask "CIDR: маска подсети запрещена"
    cidr_subnet_mask_msg "Используйте длину префикса (например, /24), а не маску подсети (255.255.255.0)."
    cidr_prefix_too_large_ipv4 "CIDR: префикс слишком большой"
    cidr_prefix_too_large_ipv4_msg "Префикс IPv4 не может быть больше 32."
    cidr_prefix_too_large_ipv6 "CIDR: префикс слишком большой"
    cidr_prefix_too_large_ipv6_msg "Префикс IPv6 не может быть больше 128."
    cidr_multiple_bad_chars "CIDR: недопустимые символы в префиксе"
    cidr_multiple_bad_chars_msg "Префикс содержит недопустимые символы: {}"

